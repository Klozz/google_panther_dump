				odpm {
					chip-name = "S2MPG12";
					max-refresh-time-ms = <0x6ddd00>;
					sample-rate-external-uhz = <0x1dcd650>;
					sample-rate-uhz = <0x7735940>;

					channels {

						channel@0 {
							channel_enabled;
							rail-name = "VSEN_C1";
						};

						channel@1 {
							channel_enabled;
							rail-name = "VSEN_C2";
						};

						channel@10 {
							channel_enabled;
							rail-name = "BUCK10M";
						};

						channel@11 {
							channel_enabled;
							rail-name = "BUCK6M";
						};

						channel@2 {
