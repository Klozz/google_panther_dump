	fragment@sbbmux {
		target-path = [2f 00];

		__overlay__ {

			sbb-mux {
				compatible = "google,sbb-mux";
				default_signals = "gp_region_0", "gp_region_1", "gp_region_2", "gp_region_3";
				gpio_names = "C1_T0__KIBBLE1_TRIG0", "C1_T1__KIBBLE1_TRIG1", "C1_T2__KIBBLE1_TRIG2", "C1_T3__KIBBLE1_TRIG3";
				gpios = <0xffffffff 0x0 0x0 0xffffffff 0x1 0x0 0xffffffff 0x2 0x0 0xffffffff 0x0 0x0>;
			};
		};
	};

	fragment@touch_bus_negotiator {
		target-path = [2f 00];

		__overlay__ {

			tbn {
				compatible = "touch_bus_negotiator";
				tbn,aoc2ap_gpio = <0xffffffff 0x7 0x1>;
				tbn,ap2aoc_gpio = <0xffffffff 0x0 0x1>;
			};
		};
	};

	fragment@typec {
		target-path = [2f 00];

		__overlay__ {

			google,usbc_port_cooling_dev {
				#cooling-cells = <0x2>;
				compatible = "google,usbc_port_cooling_dev";
				extcon = <0x1f>;
				google,usb-cd-connected-interval-ms = <0x2bc>;
				google,usb-cd-polling-interval-ms = <0x1388>;
				google,usb-cd-unplug-interval-sec = <0x2>;
			};
		};
	};

	fragment@wlc {
		target-path = [2f 00];

		__overlay__ {

			google,charger {
				google,wlc-power-supply = "wireless";
			};
		};
	};
};
