				coldrst_en = "disabled";
				coldrst_timer_val = <0x3>;
				compatible = "samsung,s2mpg12mfd";
				gpios = <0xffffffff 0x0 0x0 0xffffffff 0x1 0x0 0xffffffff 0x2 0x0 0xffffffff 0x3 0x0 0xffffffff 0x4 0x0 0xffffffff 0x1 0x0 0xffffffff 0x3 0x0>;
				init_time,hour = <0xc>;
				init_time,mday = <0x1>;
				init_time,min = <0x0>;
				init_time,mon = <0x0>;
				init_time,sec = <0x0>;
				init_time,wday = <0x3>;
				init_time,year = <0x78>;
