						wakeup = <0x1>;
					};
				};

				s2mpg12_gpio {
					#gpio-cells = <0x2>;
					gpio-controller;
					gpio-ranges = <0x24 0x0 0x0 0x6>;
					ngpios = <0x6>;
					phandle = <0x3f>;
				};

				s2mpg12_pinctrl {
