						level = <0xc 0x30>;
						target = <0x5>;

						boost0 {
							boost_threshold = <0x1f4>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0xc8>;
						};
					};

					tpmon_irq_dit {
						boost_name = "IRQ_DIT";
						extra_idx = <0x0>;
						level = <0x4 0x20>;
						target = <0x6>;

						boost0 {
							boost_threshold = <0xfa>;
							enable = <0x0>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x64>;
						};

						boost1 {
							boost_threshold = <0x1770>;
							enable = <0x0>;
							measure = <0x2>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x7d0>;
						};

						boost2 {
							boost_threshold = <0x1b58>;
							enable = <0x0>;
							measure = <0x3>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x7d0>;
						};
					};

					tpmon_mif {
						boost_name = "MIF";
						extra_idx = <0x0>;
						level = <0x0 0xf78f0>;
						target = <0x2>;

						boost0 {
							boost_threshold = <0x44c>;
							enable = <0x0>;
							measure = <0x0>;
							proto = <0x1>;
							unboost_threshold_mbps = <0x190>;
						};
					};

					tpmon_pcie_low_power {
						boost_name = "PCIE_LP";
						extra_idx = <0x0>;
						level = <0x1 0x0>;
						target = <0x3>;

						boost0 {
							boost_threshold = <0xbb8>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x4b0>;
						};
					};

					tpmon_rps {
						boost_name = "RPS";
						extra_idx = <0x0>;
						level = <0x3 0x30 0xc0>;
						target = <0x0>;

						boost0 {
							boost_threshold = <0x96 0x640>;
							enable = <0x1>;
							measure = <0x0>;
							proto = <0x0>;
							unboost_threshold_mbps = <0x3c 0x258>;
						};
					};
				};

